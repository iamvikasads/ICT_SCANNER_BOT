# Binance API (read-only key is enough — bot never trades)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Strategy / scan tuning (all optional, defaults shown)
TIMEFRAME=4h
CANDLE_LIMIT=500
TOP_N_SYMBOLS=100
EMA_FAST=9
EMA_SLOW=35
SLOPE_LOOKBACK=3
MIN_EMA_SEPARATION_PCT=0.3
MIN_BODY_SIZE_PCT=0.1

# Symbol universe refresh (in scan cycles, i.e. every N candle closes)
SYMBOL_REFRESH_EVERY=6
